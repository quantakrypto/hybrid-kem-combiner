{
  "name": "@quantakrypto/hybrid-kem-combiner",
  "version": "0.2.0",
  "description": "Generic, standalone hybrid KEM combiner (NIST SP 800-227 section 4.6.2, draft-irtf-cfrg-hybrid-kems section 5.1.3) plus the complete hybrid KEM suites of draft-irtf-cfrg-concrete-hybrid-kems",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./suites": {
      "types": "./dist/suites.d.ts",
      "import": "./dist/suites.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": false,
  "license": "MIT OR Apache-2.0",
  "author": "QuantaKrypto",
  "homepage": "https://github.com/quantakrypto/hybrid-kem-combiner",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quantakrypto/hybrid-kem-combiner.git",
    "directory": "ts"
  },
  "bugs": {
    "url": "https://github.com/quantakrypto/hybrid-kem-combiner/issues"
  },
  "keywords": [
    "cryptography",
    "post-quantum",
    "kem",
    "hybrid",
    "combiner",
    "ml-kem",
    "x-wing",
    "x25519",
    "p256",
    "p384"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.9.3"
  }
}
